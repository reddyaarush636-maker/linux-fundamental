.Linux Server Health Monitoring
------------------------------------------------
vim server_health.sh
#!/bin/bash

echo "===== SERVER HEALTH REPORT ====="

echo "Date: $(date)"
echo "Hostname: $(hostname)"

echo ""
echo "===== UPTIME ====="
uptime

echo ""
echo "===== CPU LOAD ====="
top -bn1 | head -5

echo ""
echo "===== MEMORY USAGE ====="
free -h

echo ""
echo "===== DISK USAGE ====="
df -h

echo ""
echo "===== TOP 5 MEMORY PROCESSES ====="
ps aux --sort=-%mem | head -6

echo ""
echo "===== SERVER HEALTH CHECK COMPLETED ====="

2. Disk Space Alert Script
-----------------------------------------------------------
vim  disk_alert.sh

#!/bin/bash

THRESHOLD=80

df -P | awk 'NR>1 {
    usage=$5
    gsub("%","",usage)

    if (usage >= 80) {
        print "WARNING: Disk usage is high!"
        print "Filesystem:", $1
        print "Usage:", $5
    }
}'


3. Docker Container Monitoring

13. SSL Certificate Expiry Monitoring
************************************************************************
nano ssl-cert.sh

#!/bin/bash

DOMAIN="example.com"
WARNING_DAYS=30

EXPIRY_DATE=$(echo | openssl s_client \
    -servername "$DOMAIN" \
    -connect "$DOMAIN:443" 2>/dev/null |
    openssl x509 -noout -enddate |
    cut -d= -f2)

if [[ -z "$EXPIRY_DATE" ]]; then
    echo "ERROR: Could not retrieve SSL certificate"
    exit 1
fi

EXPIRY_EPOCH=$(date -d "$EXPIRY_DATE" +%s)
CURRENT_EPOCH=$(date +%s)

REMAINING_DAYS=$(( (EXPIRY_EPOCH - CURRENT_EPOCH) / 86400 ))

echo "Domain: $DOMAIN"
echo "Certificate expires: $EXPIRY_DATE"
echo "Days remaining: $REMAINING_DAYS"

if (( REMAINING_DAYS <= WARNING_DAYS )); then
    echo "WARNING: SSL certificate expires soon!"
else
    echo "SSL certificate is healthy."
fi

14. Automated User Management Script
***********************************************************************
nano user_management.sh

#!/bin/bash

set -euo pipefail

USERNAME="${1:-}"

if [[ -z "$USERNAME" ]]; then
    echo "Usage: $0 username"
    exit 1
fi

if id "$USERNAME" &>/dev/null; then
    echo "User $USERNAME already exists"
else
    sudo useradd -m -s /bin/bash "$USERNAME"
    echo "User $USERNAME created successfully"
fi

echo
echo "User information:"
id "$USERNAME"

echo
echo "Home directory:"
getent passwd "$USERNAME" | cut -d: -f6

14. Cron Job Automation Script
**********************************************************
nano schedule_backup.sh

#!/bin/bash

set -euo pipefail

SCRIPT="/opt/scripts/backup.sh"
CRON_JOB="0 2 * * * $SCRIPT"

if [[ ! -x "$SCRIPT" ]]; then
    echo "Backup script missing or not executable"
    exit 1
fi

CURRENT_CRON=$(crontab -l 2>/dev/null || true)

if grep -Fq "$SCRIPT" <<< "$CURRENT_CRON"; then
    echo "Backup cron job already exists"
else
    {
        printf '%s\n' "$CURRENT_CRON"
        printf '%s\n' "$CRON_JOB"
    } | crontab -

    echo "Backup scheduled successfully"
fi


5. Backup Automation Script
******************************************************
vim backup.sh

#!/bin/bash

SOURCE="/var/www/html"
DEST="/home/ubuntu/backups"

DATE=$(date +%Y-%m-%d_%H-%M-%S)

mkdir -p "$DEST"

tar -czf "$DEST/backup_$DATE.tar.gz" "$SOURCE"

if [ $? -eq 0 ]; then
    echo "Backup successful!"
    echo "Location: $DEST/backup_$DATE.tar.gz"
else
    echo "Backup failed!"
    exit 1
fi

6. Linux Service Monitoring
*********************************************************************
vim service_check.sh

#!/bin/bash

SERVICES=("docker" "jenkins" "ssh" "nginx")

for SERVICE in "${SERVICES[@]}"
do
    if systemctl is-active --quiet "$SERVICE"; then
        echo "$SERVICE is RUNNING"
    else
        echo "$SERVICE is NOT RUNNING"
    fi
done

7. Application Deployment Script
****************************************************
vim deploy.sh

#!/bin/bash

APP_DIR="/var/www/html"
SOURCE_DIR="/tmp/myapp"

echo "===== APPLICATION DEPLOYMENT ====="

if [ ! -d "$SOURCE_DIR" ]; then
    echo "Application source directory not found!"
    exit 1
fi

sudo mkdir -p "$APP_DIR"

sudo cp -r "$SOURCE_DIR"/. "$APP_DIR"/

if [ $? -eq 0 ]; then
    echo "Deployment successful!"
else
    echo "Deployment failed!"
    exit 1
fi

echo "Deployment completed at $(date)"

8. Website URL Monitoring
**********************************************************
vim url_check.sh

#!/bin/bash

URL="https://www.google.com"

HTTP_CODE=$(curl -L -s -o /dev/null -w "%{http_code}" "$URL")

echo "Website: $URL"
echo "HTTP Status: $HTTP_CODE"

if [ "$HTTP_CODE" -eq 200 ]; then
    echo "Website is UP"
else
    echo "WARNING: Website may be DOWN"
fi


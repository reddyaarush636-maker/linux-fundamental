#!/bin/bash

echo "===== DOCKER STATUS ====="

if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is not installed"
    exit 1
fi

if ! docker info >/dev/null 2>&1; then
    echo "Docker service is not running or access denied"
    exit 1
fi

echo "Running Containers:"
docker ps

echo ""
echo "All Containers:"
docker ps -a

echo ""
echo "Docker Images:"
docker images

echo ""
echo "Docker Disk Usage:"
docker system df

